{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++.exe 生成活动文件",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/c", "exit", "0"],
            "dependsOn": "Build active C++ file",
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "Create build directory",
            "type": "shell",
            "command": "New-Item -ItemType Directory -Force -Path \"${workspaceFolder}\\build\" | Out-Null",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "Build active C++ file",
            "type": "shell",
            "command": "D:\\mingw\\winlibs-x86_64-posix-seh-gcc-15.2.0-mingw-w64msvcrt-14.0.0-r7\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-fdiagnostics-color=always",
                "-g3",
                "-O0",
                "${file}",
                "${workspaceFolder}\\.vscode\\console-utf8.cpp",
                "-o",
                "${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Create build directory"
            ],
            "detail": "Compile the active C++ file with debug symbols and warnings enabled."
        },
        {
            "label": "Build active C++ file for debugging",
            "type": "shell",
            "command": "D:\\mingw\\winlibs-x86_64-posix-seh-gcc-15.2.0-mingw-w64msvcrt-14.0.0-r7\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-fdiagnostics-color=always",
                "-g3",
                "-O0",
                "${file}",
                "${workspaceFolder}\\.vscode\\console-utf8.cpp",
                "-o",
                "${workspaceFolder}\\build\\${fileBasenameNoExtension}.debug.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Create build directory"
            ],
            "detail": "Compile the active C++ file to a separate debug executable.",
            "hide": true
        },
        {
            "label": "Run active C++ file in external window",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\run-utf8.ps1",
                "${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe",
                "${fileDirname}"
            ],
            "problemMatcher": [],
            "dependsOn": [
                "Build active C++ file"
            ],
            "detail": "Run the compiled program in an external window and keep it open."
        },
        {
            "label": "Build all C++ files in active folder",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-multifile.ps1",
                "${fileDirname}",
                "${workspaceFolder}\\build\\${fileBasenameNoExtension}.multi.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Create build directory"
            ],
            "detail": "Compile all .cpp files beside the active file with debug symbols and warnings enabled."
        },
        {
            "label": "Run all C++ files in active folder in external window",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\run-utf8.ps1",
                "${workspaceFolder}\\build\\${fileBasenameNoExtension}.multi.exe",
                "${fileDirname}"
            ],
            "problemMatcher": [],
            "dependsOn": [
                "Build all C++ files in active folder"
            ],
            "detail": "Run the multi-file program in an external window and keep it open."
        }
    ]
}
